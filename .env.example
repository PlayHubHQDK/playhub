# GameHub — Steam Web API credentials
# Copy this file to ".env" (same folder) and fill in your own values.
# The .env file is git-ignored and never committed.

# Your Steam Web API key — get one at https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your_steam_api_key_here

# Your 64-bit SteamID (starts with 7656...). Find it at https://steamid.io
STEAM_ID=your_steamid64_here

# Optional: port for the Part 2 web interface (default 4173)
PORT=4173

# --- Optional: price comparison (Køb-idéer tab) ---
# Free API key from https://isthereanydeal.com/apps/
ITAD_API_KEY=

# --- Optional: affiliate slots (leave empty until partner programs approve) ---
# Query-string suffix appended to that shop's links, e.g. "partner=yourtag"
AFFILIATE_SUFFIX_HUMBLE=
AFFILIATE_SUFFIX_FANATICAL=
AFFILIATE_SUFFIX_GMG=
# Instant Gaming ref tag (grey market — links only shown if set)
AFFILIATE_IG_REF=
# Show Instant Gaming links even without an affiliate ref (grey market — off by default)
SHOW_INSTANT_GAMING=
